# Copy using pnpm local:setup for isolated local development.
# For hosting, configure values as runtime secrets; never commit live values.
# Supabase Auth project settings. The publishable key is safe for browser-facing
# use but remains a runtime configuration value; never use a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact deployed app origin, without a trailing path. Example:
# https://pantrack.magkaniotisleonidas28.workers.dev
PANTRACK_APP_URL=
# Local only. This permits the loopback Vite fixture and must remain unset on a
# deployed Worker.
PANTRACK_LOCAL_AUTH=

# Use a Stripe test-mode secret for integration testing first.
STRIPE_SECRET_KEY=

# Runtime-only AES-GCM key; configured securely by the app operator.
VENDOR_ENCRYPTION_KEY=

# Clover North America developer app. Start in sandbox.
CLOVER_ENVIRONMENT=sandbox
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
