# Copy using pnpm local:setup for isolated local development.
# For hosting, configure values as runtime secrets; never commit live values.
APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Independent random 32-byte key, encoded as 64 hex characters.
AUTH_ENCRYPTION_KEY=
# Local fictional A5 review only; leave blank for normal use.
PANTRACK_A5_REVIEW=
# Use a Stripe test-mode secret for integration testing first.
STRIPE_SECRET_KEY=

# Runtime-only AES-GCM key; configured securely by the app operator.
VENDOR_ENCRYPTION_KEY=

# Clover North America developer app. Start in sandbox.
CLOVER_ENVIRONMENT=sandbox
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
