{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "deploy:dev": "vinext-cloudflare deploy",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:focused": "node scripts/test.mjs",
    "test:local": "node scripts/local-smoke.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "db:migrate:local": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "dev:usability": "node scripts/usability-preview.mjs",
    "dev:order-draft": "node scripts/order-draft-preview.mjs",
    "dev:purchase-orders": "node scripts/purchase-order-preview.mjs",
    "dev:cart": "node scripts/cart-preview.mjs",
    "cart:seed": "node scripts/cart-seed.mjs",
    "cart:evaluate": "node scripts/cart-evaluate.mjs --ai",
    "cart:check": "node scripts/cart-browser-check.mjs",
    "cart:check:http": "node scripts/cart-http-check.mjs",
    "dev:cart-worker": "node scripts/po-cart-worker-preview.mjs",
    "cart:worker": "node scripts/po-cart-worker.mjs",
    "cart:worker:credential": "node scripts/po-cart-worker-credential.mjs",
    "cart:worker:check": "node tests/po-cart-worker-processes.mjs",
    "cart:worker:check:http": "node scripts/po-cart-worker-http-check.mjs",
    "dev:cart-browser-worker": "node scripts/po-cart-browser-worker-preview.mjs",
    "cart:browser-worker": "node scripts/po-cart-browser-worker.mjs",
    "cart:browser-worker:seed": "node scripts/po-cart-browser-worker-seed.mjs",
    "cart:browser-worker:check": "node scripts/po-cart-browser-worker-check.mjs",
    "cart:browser-worker:check:http": "node scripts/po-cart-browser-worker-http-check.mjs",
    "cart:browser-worker:check:reliability": "node scripts/po-cart-browser-reliability-check.mjs",
    "cart:browser-worker:check:failures": "node scripts/po-cart-browser-failure-check.mjs",
    "cart:browser-worker:check:ai": "node scripts/po-cart-ai-worker-check.mjs",
    "cart:browser-worker:check:ai:metadata": "node scripts/po-cart-ai-metadata-check.mjs",
    "cart:browser-worker:check:ai:http": "node scripts/po-cart-ai-worker-served-check.mjs",
    "cart:browser-worker:evaluate": "node scripts/po-cart-ai-evaluate.mjs --ai",
    "cart:browser-worker:gate:ai": "node scripts/po-cart-ai-gate.mjs",
    "dev:cart-manager": "node scripts/po-cart-manager-preview.mjs",
    "cart:manager:check": "node scripts/po-cart-manager-check.mjs",
    "cart:browser-session:check": "node scripts/po-cart-browser-session-check.mjs",
    "cart:reconciliation:check": "node scripts/po-cart-reconciliation-check.mjs",
    "cart:manager:check:launcher": "node scripts/po-cart-manager-launcher-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "playwright-core": "1.61.1",
    "react-server-dom-webpack": "19.2.6",
    "saxes": "5.0.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
